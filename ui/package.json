{
  "name": "mosaic-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "design-system": "vite --config vite.design-system.config.ts --open /design-system.html",
    "design-system:build": "tsc --noEmit && vite build --config vite.design-system.config.ts",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "bash scripts/coverage.sh",
    "format": "biome format --write .",
    "check:biome": "biome ci .",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "^3.1.3",
    "@excalidraw/excalidraw": "^0.18.1",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@viz-js/viz": "^3.31.0",
    "@xyflow/react": "^12.12.1",
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0",
    "yaml": "^2.9.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-istanbul": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "babel-plugin-istanbul": "8.0.2",
    "jsdom": "^30.1.2",
    "nyc": "18.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
